# hw definition file for processing by chibios_pins.py
# for vaarcomputer FC rev 2 (target name still vaarcomputerv1)
# Djino van Dorland
# pins checked against the routed rev 2 PCB (2026-10-17)

# MCU class and specific type
MCU STM32H7xx STM32H743xx

# board ID. See Tools/AP_Bootloader/board_types.txt
APJ_BOARD_ID 9999

# crystal frequency, setup to use external oscillator
OSCILLATOR_HZ 8000000

FLASH_SIZE_KB 2048

# bootloader takes first sector
FLASH_RESERVE_START_KB 128

# ChibiOS system timer
STM32_ST_USE_TIMER 12
define CH_CFG_ST_RESOLUTION 16

# LEDs (active high, 1k to LED to GND)
PB12 LED_STATUS1 OUTPUT LOW GPIO(90)
PB13 LED_STATUS2 OUTPUT LOW GPIO(91)
define HAL_GPIO_A_LED_PIN 91
define HAL_GPIO_B_LED_PIN 90
define HAL_GPIO_LED_ON 1
define AP_NOTIFY_GPIO_LED_2_ENABLED 1

# buzzer (passive, via Q4 AO3400A)
PB5 TIM3_CH2 TIM3 GPIO(77) ALARM

# USB
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# SPI1 for IMU1 (BMI088) and IMU2 (ICM-42688-P, U6, not fitted)
PA5 SPI1_SCK SPI1
PA6 SPI1_MISO SPI1
PA7 SPI1_MOSI SPI1
PC4 IMU1_CS_A CS
PB1 IMU1_CS_G CS
PB0 IMU2_CS CS

# spi devices
SPIDEV bmi088_a SPI1 DEVID1 IMU1_CS_A MODE3 10*MHZ 10*MHZ
SPIDEV bmi088_g SPI1 DEVID2 IMU1_CS_G MODE3 10*MHZ 10*MHZ

DMA_NOSHARE SPI1*

# I2C1 = internal (BMP388, MMC5983MA), I2C4 = external (J_SENSOR / GPS compass)
I2C_ORDER I2C1 I2C4
define HAL_I2C_INTERNAL_MASK 1

PB8 I2C1_SCL I2C1
PB9 I2C1_SDA I2C1

PD12 I2C4_SCL I2C4
PD13 I2C4_SDA I2C4

# microSD on SDMMC1, 4-bit
PC8 SDMMC1_D0 SDMMC1
PC9 SDMMC1_D1 SDMMC1
PC10 SDMMC1_D2 SDMMC1
PC11 SDMMC1_D3 SDMMC1
PC12 SDMMC1_CK SDMMC1
PD2 SDMMC1_CMD SDMMC1
define HAL_OS_FATFS_IO 1

# CAN (TCAN1042, STB tied to GND)
PD0 CAN1_RX CAN1
PD1 CAN1_TX CAN1

# analog inputs
# main battery from Matek PM12S VOLT (no current sensor)
PC1 BATT_VOLTAGE_SENS ADC1 SCALE(1)
define HAL_BATT_MONITOR_DEFAULT 3
define HAL_BATT_VOLT_PIN 11
define HAL_BATT_VOLT_SCALE 21.0

# backup 2S battery, 20k/10k divider
PA4 BATT2_VOLTAGE_SENS ADC1 SCALE(1)
define HAL_BATT2_VOLT_PIN 18
define HAL_BATT2_VOLT_SCALE 3.0

# 5V rail, 10k/10k divider
PC5 VDD_5V_SENS ADC1 SCALE(2)

# order of UARTs (and USB)
# SERIAL0 USB, 1 TELEM (SiK), 2 AI computer, 3 GPS, 4 AIS, 5 SPARE1, 6 SPARE2
SERIAL_ORDER OTG1 UART8 USART2 UART7 USART1 UART4 USART3

# UART8 TELEM
PE1 UART8_TX UART8
PE0 UART8_RX UART8

# USART2 AI computer (no RTS/CTS)
PA2 USART2_TX USART2
PA3 USART2_RX USART2

# UART7 GPS
PB4 UART7_TX UART7
PB3 UART7_RX UART7

# USART1 AIS
PB14 USART1_TX USART1
PB15 USART1_RX USART1

# UART4 SPARE1
PA0 UART4_TX UART4
PA1 UART4_RX UART4

# USART3 SPARE2
PB10 USART3_TX USART3
PB11 USART3_RX USART3

# PWM outputs (rover defaults: SERVO1 = steering, SERVO3 = throttle)
PE9  TIM1_CH1 TIM1 PWM(1) GPIO(50)
PE11 TIM1_CH2 TIM1 PWM(2) GPIO(51)
PC7  TIM8_CH2 TIM8 PWM(3) GPIO(52)
PC6  TIM8_CH1 TIM8 PWM(4) GPIO(53)

# relay module on J23
PD4 RELAY1 OUTPUT LOW GPIO(81)
define RELAY1_PIN_DEFAULT 81

# nav lamp MOSFETs (use as RELAY2..4 via RELAYx_PIN 82..84)
PD9  MOSFET1 OUTPUT LOW GPIO(82)
PD10 MOSFET2 OUTPUT LOW GPIO(83)
PD11 MOSFET3 OUTPUT LOW GPIO(84)

# leak sensor input on J21 (sensor pulls to 3.3V when wet)
PD3 LEAK INPUT PULLDOWN GPIO(85)

DMA_PRIORITY S*

define HAL_STORAGE_SIZE 32768

# use last 2 pages for flash storage
# H743 has 16 pages of 128k each
STORAGE_FLASH_PAGE 14

# no safety switch
define HAL_HAVE_SAFETY_SWITCH 0

# IMU: BMI088 (U4)
IMU BMI088 SPI:bmi088_a SPI:bmi088_g ROTATION_NONE

define HAL_DEFAULT_INS_FAST_SAMPLE 1

# barometer is BMP388 on I2C1
BARO BMP388 I2C:0:0x76

# onboard compass MMC5983MA on I2C1, address 0x30
COMPASS MMC5XX3 I2C:0:0x30 false ROTATION_NONE

# also probe for external compasses (e.g. GPS mast) on I2C4
define ALLOW_ARM_NO_COMPASS
define AP_COMPASS_PROBING_ENABLED 1
define HAL_COMPASS_AUTO_ROT_DEFAULT 2

# build ABIN for flash-from-bootloader support:
env BUILD_ABIN True
